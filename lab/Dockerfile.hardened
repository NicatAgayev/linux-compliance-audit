# =============================================================
# HARDENED TEST ENVIRONMENT
# Purpose: same system as the vulnerable lab, with all six
# misconfigurations remediated. Used to verify that the audit
# tool reports PASS on a compliant system.
# =============================================================

FROM ubuntu:24.04

RUN apt-get update && \
    apt-get install -y openssh-server sudo && \
    rm -rf /var/lib/apt/lists/*

# FIX 1: Direct root login over SSH is disabled
RUN sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config

# FIX 2: SSH rejects empty passwords
RUN sed -i 's/^#\?PermitEmptyPasswords.*/PermitEmptyPasswords no/' /etc/ssh/sshd_config

# FIX 3: Account exists but is locked (no empty password,
#        no hardcoded password in source code)
RUN useradd -m -s /bin/bash testuser && passwd -l testuser

# FIX 4: Password hash file restricted to root and shadow group
RUN chown root:shadow /etc/shadow && chmod 640 /etc/shadow

# FIX 5: No additional UID 0 account is created

# FIX 6: Sudo requires password authentication
RUN useradd -m -s /bin/bash devops && \
    echo "devops ALL=(ALL) ALL" > /etc/sudoers.d/devops && \
    chmod 440 /etc/sudoers.d/devops

CMD ["sleep", "infinity"]
